@using BookShop.Domain.Enums
@model BookShop.Application.ViewModels.Common.BookDetailsResponseVM

@{
    ViewData["Title"] = Model.Book.Title;

    var visibleRatings = Model.Book.RatingResponse?
    .Where(r =>
        r.Status == RatingStatus.Approved || // Show approved reviews to everyone
        (Model.CurrentUserId != null &&      // AND if logged in...
         r.AppUserId == Model.CurrentUserId)) // ...show pending reviews ONLY to the author
    .ToList();

    var ratingAvg = Model.RatingAverageCounts?
        .Where(r => r.Status == RatingStatus.Approved)
        .ToList();
}

<div class="container py-4 py-md-5">
    <!-- Back Button -->
    <div class="row mb-4">
        <div class="col">
            <a asp-area="Customer" asp-controller="Book" asp-action="Index"
               class="btn btn-link link-secondary text-decoration-none p-0 d-inline-flex align-items-center gap-2 fw-semibold">
                <i class="bi bi-arrow-left"></i> Back to Catalog
            </a>
        </div>
    </div>

    <!-- Main Details Row -->
    <div class="row g-4 g-lg-5 mb-5">
        <!-- Left Column: Image -->
        <div class="col-md-6">
            <div class="sticky-md-top pt-md-2">
                <div class="shadow-sm rounded-4 overflow-hidden border border-light-subtle bg-light" style="height: 600px;">
                    <img src="@Model.Book.ImageUrl" alt="@Model.Book.Title"
                         class="img-fluid w-100 h-100" />
                </div>
            </div>
        </div>

        <!-- Right Column: Info & Actions -->
        <div class="col-md-6 d-flex flex-column justify-content-between">
            <div class="mb-4">
                <div class="mb-3 d-flex gap-2">
                    <span class="badge bg-body-secondary text-dark border border-secondary-subtle rounded-pill px-3 py-2 text-uppercase fw-semibold"
                          style="font-size: 0.75rem;">
                        <i class="bi bi-tag-fill me-1 text-primary"></i> @Model.Book.CategoryName
                    </span>
                    @if (Model.Book.IsNew)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 text-uppercase fw-semibold"
                              style="font-size: 0.75rem;">
                            New Arrival
                        </span>
                    }
                </div>

                <h1 class="fw-bold text-dark mb-2 display-6">@Model.Book.Title</h1>
                <p class="text-secondary fw-medium mb-3">By <span class="text-dark">@Model.Book.AuthorName</span></p>

                <!-- Rating Partial View Integration -->
                <div class="mb-3">
                    @await Html.PartialAsync("_StarRating", ratingAvg)
                </div>

                <!-- Pricing -->
                <div class="d-flex align-items-baseline gap-3 mb-4">
                    @if (Model.Book.SpecialPrice.HasValue && Model.Book.SpecialPrice < Model.Book.Price)
                    {
                        <span class="fs-1 fw-bold text-danger">
                            $@Model.Book.SpecialPrice.Value.ToString("0.00")
                        </span>
                        <span class="fs-4 text-body-tertiary text-decoration-line-through fw-light">
                            $@Model.Book.Price.ToString("0.00")
                        </span>
                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1 fs-6 fw-semibold">
                            PROMO
                        </span>
                    }
                    else
                    {
                        <span class="fs-1 fw-bold text-dark">$@Model.Book.Price.ToString("0.00")</span>
                    }
                </div>

                <hr class="my-4 opacity-25" />

                <h6 class="text-uppercase fw-bold text-secondary-emphasis mb-2 small">Description</h6>
                <p class="text-muted lh-lg fs-6 mb-4">@Model.Book.Description</p>

                <!-- Book Metadata Blocks -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle">
                            <span class="text-muted d-block text-uppercase small">Pages</span>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-book me-1"></i> @Model.Book.PageNumber Pages
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle">
                            <span class="text-muted d-block text-uppercase small">Stock Status</span>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-box-seam me-1"></i> @(Model.Book.Stock > 0 ? $"{Model.Book.Stock} Available" : "Out of Stock")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quantity & Add to Cart Box -->
            <div class="p-4 bg-body border border-light-subtle rounded-4 shadow-sm">
                <div class="row g-3 align-items-end">
                    <div class="col-sm-5">
                        <label for="cartQty" class="form-label text-dark small fw-bold mb-2">
                            Select Quantity
                        </label>
                        <div class="d-flex align-items-center border border-secondary-subtle rounded-3 bg-light p-1">
                            <button type="button" class="btn btn-link text-dark shadow-none p-2 border-0" id="btn-minus">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <span class="text-center fw-bold bg-transparent shadow-none fs-5 py-2 px-4 flex-grow-1" id="cartQty">1</span>
                            <button type="button" class="btn btn-link text-dark shadow-none p-2 border-0" id="btn-plus">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <button type="button" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold py-2 d-flex align-items-center justify-content-center gap-2 fs-6 shadow"
                                id="AddToCart" data-bookid="@Model.Book.Id">
                            <i class="bi bi-bag-plus"></i> Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Rating & Reviews Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
        <!-- Header Area -->
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pb-4 mb-4 border-bottom">
            <div>
                <h3 class="fw-bold text-dark mb-1">Customer Reviews</h3>
                <div class="d-flex align-items-center gap-2 text-warning">
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <i class="bi bi-star-fill"></i>
                    <span class="text-muted small ms-1">(Based on overall ratings)</span>
                </div>
            </div>
            <div>
                @if (Model.CurrentUserId != null)
                {
                    <button type="button" class="btn btn-dark rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#ratingModal">
                        <i class="bi bi-pencil-square me-2"></i>Write a Review
                    </button>
                }
                else
                {
                    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Log in to Review
                    </a>
                }
            </div>
        </div>

        <!-- Reviews List Container -->
        <div class="vstack gap-3 overflow-y-auto pe-2" style="max-height: 600px;">
            @if (visibleRatings != null && visibleRatings.Any())
            {
                @foreach (var review in visibleRatings)
                {
                    <div class="card border-0 bg-light rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 45px; height: 45px;">
                                    @review.FirstName.Substring(0, 1)@review.LastName.Substring(0, 1)
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@review.FirstName @review.LastName</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @(review.Status == RatingStatus.Approved ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") rounded-pill px-2 py-1 small">
                                            @(review.Status == RatingStatus.Approved ? "Verified Buyer" : "Pending Approval")
                                        </span>
                                        <span class="text-muted small">&bull; @review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-warning small">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Value)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-muted opacity-50"></i>
                                    }
                                }
                            </div>
                        </div>
                        <p class="text-secondary mb-0 small lh-lg">
                            @review.Review
                        </p>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-square-text display-4 text-muted opacity-25 mb-3 d-block"></i>
                    <p class="mb-0 fw-medium">No reviews yet. Be the first to review this book!</p>
                </div>
            }
        </div>
    </div>

    <!-- Write Review Modal -->
    <div class="modal fade" id="ratingModal" tabindex="-1" aria-labelledby="ratingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <form asp-area="Customer" asp-controller="Rating" asp-action="Add" method="post">
                    <input type="hidden" name="BookId" value="@Model.Book.Id" />

                    <div class="modal-header bg-light border-bottom px-4 py-3">
                        <h5 class="modal-title fw-bold text-dark" id="ratingModalLabel">Create Review</h5>
                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <!-- Amazon-Style Interactive Star Picker -->
                        <div class="mb-4 text-center bg-light rounded-4 p-3 border">
                            <label class="form-label text-muted small fw-bold text-uppercase tracking-wider d-block mb-2">Overall Rating</label>
                            <div id="star-rating-picker" class="d-inline-flex gap-2 fs-2 text-warning" style="cursor: pointer;">
                                <i class="bi bi-star-fill rating-star" data-value="1"></i>
                                <i class="bi bi-star-fill rating-star" data-value="2"></i>
                                <i class="bi bi-star-fill rating-star" data-value="3"></i>
                                <i class="bi bi-star-fill rating-star" data-value="4"></i>
                                <i class="bi bi-star-fill rating-star" data-value="5"></i>
                            </div>
                            <input type="hidden" id="RatingValue" name="Value" value="5" />
                        </div>

                        <!-- Review Textarea -->
                        <div class="mb-0">
                            <label for="reviewText" class="form-label text-dark small fw-bold">Add a written review</label>
                            <textarea class="form-control bg-light border-light rounded-3 shadow-none p-3" id="reviewText" name="Review" rows="4" placeholder="What did you like or dislike? What was your overall experience?"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer bg-light border-top px-4 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-semibold shadow-sm">Submit Review</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Similar Books Section with Owl Carousel -->
    @if (Model.SimilarBooks != null && Model.SimilarBooks.Any())
    {
        <div class="row mt-5 pt-4 border-top border-light-subtle">
            <div class="col-12 d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold text-dark m-0">You May Also Like</h3>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm rounded-circle" id="similar-prev">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm rounded-circle" id="similar-next">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="col-12">
                <div class="owl-carousel owl-theme" id="similarBooksCarousel">
                    @await Html.PartialAsync("_BookCard" , Model.SimilarBooks)
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function(){

            function FetchCartCount() {
                $.getJSON('/Customer/ShoppingCart/GetCartCount', function(data) {
                    $('.cart-badge').text(data.count);
                });
            }

            // Quantity Increment/Decrement
            var qtyInput = $('#cartQty');

            $('#btn-plus').click(function(){
                var currentValue = parseInt(qtyInput.text());
                qtyInput.text(currentValue + 1);
            });

            $('#btn-minus').click(function(){
                var currentValue = parseInt(qtyInput.text());
                if(currentValue > 1){
                    qtyInput.text(currentValue - 1);
                }
            });

            $(document).on('click', '#AddToCart', function (e) {
                e.preventDefault();

                var button = $(this);
                var bookId = button.data('bookid');
                var quantity = parseInt(qtyInput.text()) || 1;

                console.log("Book ID:", bookId);
                console.log("Quantity:", quantity);

                $.ajax({
                    url: '/Customer/ShoppingCart/Add',
                    type: 'POST',
                    data: {
                        bookId: bookId,
                        quantity: quantity
                    },
                    success: function (response) {
                        if (response.success) {
                            FetchCartCount();

                            toastr.success(response.message || "Item added to the cart successfully.");
                            $('#cartQty').text(1);
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status == 401) {
                            toastr.warning("Please log in to continue.");
                        } else {
                            toastr.error("Something went wrong.");
                        }
                    }
                })
            });

            // Similar Books Carousel Initialization
            var $similarCarousel = $('#similarBooksCarousel');

            if ($similarCarousel.length) {
                $similarCarousel.owlCarousel({
                    loop: false,
                    margin: 20,
                    nav: false,
                    dots: false,
                    autoplay: false,
                    responsive: {
                        0: { items: 1 },
                        576: { items: 2 },
                        992: { items: 3 },
                        1200: { items: 4 }
                    }
                });

                $('#similar-prev').on('click', function() {
                    $similarCarousel.trigger('prev.owl.carousel');
                });

                $('#similar-next').on('click', function() {
                    $similarCarousel.trigger('next.owl.carousel');
                });
            }

                // Amazon-Style Interactive Star Rating Logic
        const $stars = $('.rating-star');
        const $ratingInput = $('#RatingValue');

        function updateStarColors(val) {
            $stars.each(function() {
                const starVal = parseInt($(this).data('value'));
                if (starVal <= val) {
                    $(this).removeClass('bi-star').addClass('bi-star-fill');
                } else {
                    $(this).removeClass('bi-star-fill').addClass('bi-star');
                }
            });
        }

        // Hover effect
        $stars.on('mouseenter', function() {
            const val = parseInt($(this).data('value'));
            updateStarColors(val);
        });

        // Revert to selected value on mouse leave container
        $('#star-rating-picker').on('mouseleave', function() {
            const currentVal = parseInt($ratingInput.val()) || 5;
            updateStarColors(currentVal);
        });

        // Click event to lock selection value
        $stars.on('click', function() {
            const val = parseInt($(this).data('value'));
            $ratingInput.val(val);
            updateStarColors(val);
        });
        });
    </script>
}
